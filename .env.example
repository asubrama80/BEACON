# BEACON — Development Environment Configuration
# Copy this file to .env and adjust values for your local machine.
# Never commit the real .env file.

# ---------------------------------------------------------------- application
NODE_ENV=development

# --------------------------------------------------------------------- backend
BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0
# Frontend origin allowed to make cross-origin, credentialed (cookie-based) requests.
CORS_ORIGIN=http://localhost:5173

# -------------------------------------------------------------------- frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:4000

# ------------------------------------------------------------------ postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=beacon_dev
POSTGRES_USER=beacon
POSTGRES_PASSWORD=change_me_in_local_env

# Full connection string derived from the values above (used by backend/database tooling)
DATABASE_URL=postgres://beacon:change_me_in_local_env@localhost:5432/beacon_dev

# ------------------------------------------------------------- authentication
# Session cookie lifetime, in hours.
SESSION_TTL_HOURS=12

# Argon2id parameters for password hashing. Defaults follow OWASP's minimum recommendation
# (19 MiB memory, 2 iterations, 1 thread). Increase memoryCost/timeCost for stronger hashing
# if your deployment's hardware can absorb the extra latency per login.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Display name shown in authenticator apps during MFA enrollment.
MFA_ISSUER=BEACON

# 32 random bytes, base64-encoded, used to encrypt TOTP secrets at rest (AES-256-GCM).
# Generate your own — never reuse this placeholder:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=change_me_generate_a_real_32_byte_base64_key

# Minimum password length enforced at account creation/reset.
PASSWORD_MIN_LENGTH=12

# Per-email login throttle: lock out after this many consecutive failures, for this many minutes.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15

# Per-IP login rate limit (separate, coarser layer on top of the per-email throttle above).
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW=1 minute

# ------------------------------------------------------------ contact import
# Bounds for CSV/XLSX bulk Contact import (Module 05). All optional — sensible defaults apply
# if unset (5 MB / 2000 rows / 40 columns / 30-minute unconfirmed-batch expiry).
# CONTACT_IMPORT_MAX_FILE_SIZE_BYTES=5242880
# CONTACT_IMPORT_MAX_ROWS=2000
# CONTACT_IMPORT_MAX_COLUMNS=40
# CONTACT_IMPORT_BATCH_TTL_MINUTES=30

# ------------------------------------------------------- notification providers
# Module 10. Selects which adapter actually submits Alert notifications. "mock" (the default)
# performs zero external transmission — safe for local development and CI with no credentials.
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock

# Required only when SMS_PROVIDER=twilio. Never commit real values — variable NAMES only here.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Required only when EMAIL_PROVIDER=ses. AWS credentials themselves are resolved via the
# standard AWS SDK credential chain (environment/shared config/workload identity) — never stored
# in this file or in the application database.
# AWS_REGION=
# SES_FROM_EMAIL=

# Bounded retry/concurrency/timeout tuning for provider dispatch. All optional — sensible
# development defaults apply if unset (3 attempts / 500ms backoff base / 5 concurrent calls /
# 10s per-call timeout).
# PROVIDER_MAX_ATTEMPTS=3
# PROVIDER_RETRY_BASE_MS=500
# PROVIDER_DISPATCH_CONCURRENCY=5
# PROVIDER_TIMEOUT_MS=10000
